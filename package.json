    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.1",
    "prettier": "^3.3.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@aws-sdk/client-ec2": "^3.800.0",
    "@aws-sdk/client-ssm": "^3.799.0"
  }
